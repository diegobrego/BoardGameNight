rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
//
// Players have no passwords: anyone who has the site link can read and edit
// the calendar. These rules keep that open door narrow: only the kinds of
// documents the app uses, in the shape it uses them.
//
// Deleting a player, or editing or removing an entry in the hall of fame, is different.
// It needs a signed-in admin: a Google account whose user ID has a document in
// the `admins` collection. Only you can create those documents (by hand, in the
// Firebase console); nobody can through the app.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The shape of a hall-of-fame entry, as it will be stored (for a new one, and for an
    // admin's edit of an existing one).
    function validPlay() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'game', 'winner', 'players', 'names', 'loggedBy', 'createdAt', 'note', 'campaign'])
          && d.date is string
          && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.game is map
          && d.game.name is string
          && d.game.name.size() > 0
          && d.game.name.size() <= 100
          && (d.winner == null || d.winner is string)
          && d.players is list
          && d.players.size() >= 1
          && d.players.size() <= 30
          && d.names is map
          && d.names.size() <= 30
          && d.get('note', '').size() <= 140
          && d.get('campaign', '').size() <= 40;
    }

    // A signed-in account can check whether it is an admin, and nothing else here.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      // `games` is the player's list of favourite / owned games (at most 60: keep in step
      // with MAX_MY_GAMES in js/mygames.js).
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'avatar', 'createdAt', 'games'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 20
                            && request.resource.data.avatar is number
                            && request.resource.data.get('games', []) is list
                            && request.resource.data.get('games', []).size() <= 60;
      allow delete: if isAdmin();
    }

    // One document per calendar day, named like "2026-10-09".
    //   votes   maps a game to the players who voted for it
    //   brings  maps a game to the players who will bring it
    //   details is the game night's { place, time } (time as "19:30", or empty)
    match /days/{day} {
      allow read: if true;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.keys().hasOnly(['players', 'games', 'votes', 'brings', 'details'])
                            && request.resource.data.get('players', []).size() <= 50
                            && request.resource.data.get('games', []).size() <= 50
                            && request.resource.data.get('votes', {}) is map
                            && request.resource.data.get('votes', {}).size() <= 50
                            && request.resource.data.get('brings', {}) is map
                            && request.resource.data.get('brings', {}).size() <= 50
                            && request.resource.data.get('details', {}) is map
                            && request.resource.data.get('details', {}).get('place', '').size() <= 120
                            && request.resource.data.get('details', {}).get('time', '').matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$');
      allow delete: if false;
    }

    // The hall of fame: one document per game played on a game night. Entries can be
    // added by anyone. Only an admin can edit or remove one (from the Admin page).
    match /plays/{playId} {
      allow read: if true;
      allow create: if validPlay();
      allow update: if isAdmin() && validPlay();
      allow delete: if isAdmin();
    }

    // Campaigns: long games played over several sessions (Arcs, Oath...). Their sessions are
    // ordinary `plays` entries that carry the campaign's id. Anyone can start one. While it is
    // running, the people in it, the lock, the planned next date and the finish (status, date,
    // winner) can change. Once finished it is frozen, apart from being reopened (status back to
    // 'active', no winner, no finish date). (The site only lets the creator lock, add people
    // after the lock, finish and reopen, but these rules can't check who is who: players have
    // no passwords, so a determined friend could still do it by hand.)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['game', 'title', 'players', 'names', 'status', 'locked', 'startedAt', 'next', 'finishedAt', 'winner', 'createdBy', 'createdAt'])
                    && request.resource.data.locked == false
                    && request.resource.data.game is map
                    && request.resource.data.game.name is string
                    && request.resource.data.game.name.size() > 0
                    && request.resource.data.game.name.size() <= 100
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.players is list
                    && request.resource.data.players.size() >= 1
                    && request.resource.data.players.size() <= 30
                    && request.resource.data.names is map
                    && request.resource.data.names.size() <= 30
                    && request.resource.data.status == 'active'
                    && request.resource.data.startedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.next.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
                    && request.resource.data.finishedAt == ''
                    && request.resource.data.winner == null;
      allow update: if resource.data.status == 'active'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'names', 'locked', 'next', 'status', 'finishedAt', 'winner'])
                    && request.resource.data.players is list
                    && request.resource.data.players.size() >= 1
                    && request.resource.data.players.size() <= 30
                    && request.resource.data.names is map
                    && request.resource.data.names.size() <= 30
                    && request.resource.data.get('locked', false) is bool
                    && request.resource.data.status in ['active', 'finished']
                    && request.resource.data.next.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
                    && request.resource.data.finishedAt.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
                    && (request.resource.data.winner == null || request.resource.data.winner is string);
      // reopening a finished campaign: nothing else about it changes
      allow update: if resource.data.status == 'finished'
                    && request.resource.data.status == 'active'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt', 'winner'])
                    && request.resource.data.finishedAt == ''
                    && request.resource.data.winner == null;
      // The site only offers "Remove" to the campaign's creator (and an admin), but like the
      // other creator-only buttons that is the site's courtesy, not something these rules can
      // check, so anyone could remove one by hand. Its sessions are `plays` entries and stay.
      allow delete: if true;
    }
  }
}
