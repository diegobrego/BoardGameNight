rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
//
// Players have no passwords: anyone who has the site link can read and edit
// the calendar. These rules keep that open door narrow: only the kinds of
// documents the app uses, in the shape it uses them.
//
// Deleting a player is different. It needs a signed-in admin: a Google account
// whose user ID has a document in the `admins` collection. Only you can create
// those documents (by hand, in the Firebase console); nobody can through the app.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in account can check whether it is an admin, and nothing else here.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'avatar', 'createdAt'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 20
                            && request.resource.data.avatar is number;
      allow delete: if isAdmin();
    }

    // One document per calendar day, named like "2026-10-09". `votes` maps a game to
    // the players who voted for it.
    match /days/{day} {
      allow read: if true;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.keys().hasOnly(['players', 'games', 'votes'])
                            && request.resource.data.get('players', []).size() <= 50
                            && request.resource.data.get('games', []).size() <= 50
                            && request.resource.data.get('votes', {}) is map
                            && request.resource.data.get('votes', {}).size() <= 50;
      allow delete: if false;
    }
  }
}
